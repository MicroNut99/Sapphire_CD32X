+                if (q == sn[h]) { int dup = 0; for (int r = 1; r < i; r++) dup |= (u & B16(r)) && (v->color[p * 16 + r] & 0x1FF) == c; need += !dup; } }
+            const int over = sn[h] + need > 15 ? sn[h] + need - 15 : 0;
