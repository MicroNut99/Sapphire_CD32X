+/* Sapphire docs/68: the palettes in use, the most entries on the map first (then the most indices) - the order the pack and
+   the merge place them in. By index count alone (as before) the title's hangar, 825 of its 1,024 entries in palette 15,
+   came last: its greys and yellows shown by the mech's and the letters' colours, a fifth of the picture's pixels off */
+static int pal_order(const Bg2 *b, const V32 *v, int *ord)
+{
+    uint16_t cnt[16] = { 0 }; const int ne = map_n(v); int n = 0;
+    for (int a = 0; a < ne; a++) cnt[v->vram[a] >> 12]++;
+    for (int p = 0; p < 16; p++) if (b->used[p]) ord[n++] = p;
+    for (int i = 0; i < n; i++) for (int j = i + 1; j < n; j++) {
+        const int pi = ord[i], pj = ord[j];
+        if (cnt[pj] > cnt[pi] || (cnt[pj] == cnt[pi] && popc16(b->used[pj]) > popc16(b->used[pi]))) { ord[i] = pj; ord[j] = pi; } }
+    return n;
+}
