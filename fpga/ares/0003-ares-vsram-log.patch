From c05169d9658e90665c336db013e2a7a1354ebeb2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 17:17:53 -0800
Subject: [PATCH] VDP: ARES_VSRAM_LOG (DIAG): VSRAM 0's writes with the line
 they land on (Sapphire docs/35)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NuNYgMfRuDG9Mw67wd4uwV
---
 ares/md/vdp/fifo.cpp | 7 ++++++-
 ares/md/vdp/main.cpp | 2 +-
 ares/md/vdp/vdp.hpp  | 1 +
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/ares/md/vdp/fifo.cpp b/ares/md/vdp/fifo.cpp
index e2d2f65..bcb15c0 100644
--- a/ares/md/vdp/fifo.cpp
+++ b/ares/md/vdp/fifo.cpp
@@ -57,8 +57,13 @@ auto VDP::FIFO::run() -> bool {
     vdp.vram.writeByte(slots[0].address | 1, slots[0].data.byte(0));
   else if(slots[0].target == 3)
     vdp.cram.write(slots[0].address >> 1, slots[0].data);
-  else if(slots[0].target == 5)
+  else if(slots[0].target == 5) {
+    //(DIAG, Sapphire CD32X docs/35: ARES_VSRAM_LOG=<from frame> prints VSRAM 0's writes with the line they land on)
+    static s64 from = getenv("ARES_VSRAM_LOG") ? atoll(getenv("ARES_VSRAM_LOG")) : -1;
+    if(from >= 0 && (slots[0].address >> 1) == 0 && (s64)vdp.diagFrames >= from)
+      fprintf(stderr, "vsram0 frame %llu line %u = %03x\n", (unsigned long long)vdp.diagFrames, (u32)vdp.vcounter(), (u32)(slots[0].data & 0x3ff));
     vdp.vsram.write(slots[0].address >> 1, slots[0].data);
+  }
   else
     debug(unusual, "[VDP::FIFO] write target = 0x", hex(slots[0].target));
 
diff --git a/ares/md/vdp/main.cpp b/ares/md/vdp/main.cpp
index fd51370..aa2af72 100644
--- a/ares/md/vdp/main.cpp
+++ b/ares/md/vdp/main.cpp
@@ -75,7 +75,7 @@ template<bool _h40, bool _refresh> auto VDP::tick() -> void {
 
 auto VDP::vblankcheck() -> void {
   if(v28()) {
-    if(vcounter() == 0x0e0) vblank(1);
+    if(vcounter() == 0x0e0) { vblank(1); diagFrames++; }
     if(vcounter() == 0x1ff) vblank(0);
   }
   if(v30()) {
diff --git a/ares/md/vdp/vdp.hpp b/ares/md/vdp/vdp.hpp
index 677a56c..88f64ad 100644
--- a/ares/md/vdp/vdp.hpp
+++ b/ares/md/vdp/vdp.hpp
@@ -34,6 +34,7 @@ struct VDP : Thread {
 
   auto hcounter() const -> u32 { return state.hcounter; }
   auto vcounter() const -> u32 { return state.vcounter; }
+  u64 diagFrames = 0;   //(DIAG: vblanks seen, for ARES_VSRAM_LOG)
   auto field() const -> bool { return state.field; }
   auto hblank() const -> bool { return state.hblank; }
   auto vblank() const -> bool { return state.vblank; }
-- 
