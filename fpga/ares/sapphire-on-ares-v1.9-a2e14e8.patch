diff --git a/ares/md/cartridge/board/sapphire-cells.hpp b/ares/md/cartridge/board/sapphire-cells.hpp
new file mode 100644
index 0000000..d04b37d
--- /dev/null
+++ b/ares/md/cartridge/board/sapphire-cells.hpp
@@ -0,0 +1,121 @@
+//Sapphire CD32X's FPGA cell store (github.com/MicroNut99/Sapphire_CD32X docs/28-29, fpga/huc/cellstore.c), a test
+//model on the EverDrive board for the FIFO playback (ARES_CELLS=<the FIFO's bytes>, ARES_CELLS_VRAM=<vdc_start.bin>,
+//ARES_CELLS_LEAD=<frames, default 1>). The FIFO is the level slot's file (cart 0x200000); the model runs its own
+//cursor on it up to ARES_CELLS_LEAD frame boundaries past the count the SH2 writes (register 0xca), as the FPGA would be.
+//The stores are served at cart 0x170000 (live) and 0x194000 (frozen); the frozen bits through the Arcade Card
+//engine's window: write register 0xc6 = group (16 cells), read register 0xc7 = its bits; write 0xc8 = release;
+//read 0xc9 = the boundary count the lock came at (1: the first boundary in the FIFO), 0xffff: not locked yet; write
+//0xca = the boundaries the SH2 has passed (low 8 bits). None of them answers until the SH2 writes 0xcb = 0xa5 then at
+//once 0xcb = 0x5a (the start: the store goes back to vdc_start), so a plain read across the window does nothing.
+struct SapphireCells {
+  static constexpr u32 Cell = 288, Odd = 128, Mask = 272, LiveAt = 0x170000, FrozenAt = 0x194000, TilesAt = 0x1b8000, End = 0x1ba000;
+  u32 tfrozen[2048]; u8 tisFrozen[2048];   //(docs/31: the tiles' hash << 16 | colour mask, as at the lock, at 0x1b8000)
+  u16 cvram[0x8000], startVram[0x8000];
+  bool armedGate = false, live_ = false;   //(the registers answer only after the unlock: 0xcb = 0xa5, then 0xcb = 0x5a at once)
+  u8 live[512][Cell], frozen[512][Cell];
+  u8 isFrozen[512];
+  bool locked = false, armed = false, on = false;
+  u32 fifoBytes = 0, cursor = 0, lead = 1, group = 0;
+  u32 fifoAddr = 0;          //the model's VRAM address (FIFO type 2)
+  u64 liveTotal = 0; bool liveRing = false;   //(docs/40: the FIFO a ring the stand-in CPU writes - its entries so far)
+  u64 freezes = 0;
+
+  auto row(u32 c, u32 y) -> void {
+    u16* w = cvram + c * 64;
+    u32 p0 = w[y], p1 = w[16 + y], p2 = w[32 + y], p3 = w[48 + y];
+    u8* e = live[c] + 8 * y; u8* o = live[c] + Odd + 9 * y;
+    for(u32 x : range(16)) {
+      u32 b = 15 - x;
+      u32 v = (p0 >> b & 1) | (p1 >> b & 1) << 1 | (p2 >> b & 1) << 2 | (p3 >> b & 1) << 3;
+      if(x & 1) e[x >> 1] = (e[x >> 1] & 0xf0) | v; else e[x >> 1] = (e[x >> 1] & 0x0f) | v << 4;
+    }
+    o[0] = e[0] >> 4;
+    for(u32 k = 1; k < 8; k++) o[k] = (e[k - 1] & 15) << 4 | e[k] >> 4;
+    o[8] = (e[7] & 15) << 4;
+    u32 m = (u32)live[c][Mask] << 8 | live[c][Mask + 1];
+    if(p0 | p1 | p2 | p3) m |= 0x8000 >> y; else m &= ~(0x8000u >> y);
+    live[c][Mask] = m >> 8; live[c][Mask + 1] = m;
+  }
+  auto tinfo(u32 t) -> u32 {   //Sapphire's tools/m3rt/rt_bg2.c tile_hash, tile_mask (fpga/huc/cellstore.c tinfo)
+    u16* w = cvram + t * 16; u32 h = 0x811c9dc5;
+    for(u32 k : range(16)) h = (h ^ w[k]) * 0x01000193;
+    u32 m = 0;
+    for(u32 y : range(8)) { u32 p01 = w[y], p23 = w[8 + y];
+      for(u32 x : range(8)) { u32 sh = 7 - x; m |= 1u << ((p01 >> sh & 1) | (p01 >> (sh + 8) & 1) << 1 | (p23 >> sh & 1) << 2 | (p23 >> (sh + 8) & 1) << 3); } }
+    return (u32)(u16)(h ^ h >> 16) << 16 | (m & ~1u);
+  }
+  auto vram(u32 a, u16 w) -> void {
+    if(a >= 0x8000) return;
+    if(cvram[a] == w) return;
+    u32 c = a >> 6;
+    if(locked && !isFrozen[c]) { memory::copy(frozen[c], live[c], Cell); isFrozen[c] = 1; freezes++; }
+    if(locked && !tisFrozen[a >> 4]) { tfrozen[a >> 4] = tinfo(a >> 4); tisFrozen[a >> 4] = 1; }
+    cvram[a] = w; row(c, a & 15);
+  }
+  u32 boundaries = 0, lockedAt = 0xffff;
+  auto start() -> void {
+    memory::copy(cvram, startVram, sizeof cvram);
+    memory::fill(live, sizeof live);
+    for(u32 c : range(512)) for(u32 y : range(16)) row(c, y);
+    memory::fill(isFrozen, sizeof isFrozen); memory::fill(tisFrozen, sizeof tisFrozen); locked = armed = false; cursor = 0; fifoAddr = 0; freezes = 0; sh2At = 0; boundaries = 0; lockedAt = 0xffff;
+  }
+  //a register write (r, v); false: not the store's (the engine's own, or the store still locked out)
+  template<typename Ram> auto write(u32 r, u32 v, Ram ram) -> bool {
+    bool prev = armedGate; armedGate = false;
+    if(r == 0xcb) { if(v == 0xa5) armedGate = true; else if(v == 0x5a && prev) { start(); live_ = true; if(getenv("ARES_CELLS_LOG")) fprintf(stderr, "cells: unlocked\n"); } return true; }
+    if(!live_) return false;
+    if(r == 0xc6) { group = v; return true; }
+    if(r == 0xc8) { release(); return true; }
+    if(r == 0xca) { frame(v, ram); return true; }
+    return false;
+  }
+  const u16 (*checkAt)[0x8000] = nullptr; const u32* checkPic = nullptr;   //(DIAG: ARES_HUC_VCHECK, the stand-in's VRAM by picture)
+  auto boundary() -> void {
+    if(checkAt) { u32 k = boundaries & 63; if(checkPic[k] == boundaries) { u32 bad = 0, first = 0xffff; for(u32 i : range(0x8000)) if(cvram[i] != checkAt[k][i]) { if(!bad) first = i; bad++; }
+      if(bad) { fprintf(stderr, "cells: boundary %u: %u VRAM words apart, first %04x:", boundaries, bad, first); u32 n = 0; for(u32 i : range(0x8000)) if(cvram[i] != checkAt[k][i] && n++ < 6) fprintf(stderr, " %04x=%04x/%04x", i, cvram[i], checkAt[k][i]); fprintf(stderr, "\n"); checkAt = nullptr; } } }
+    boundaries++; if(armed) { armed = false; locked = true; lockedAt = boundaries & 0x7fff;   /*(15 bits, as the RTL: 0xffff is "not locked yet" - Sapphire docs/59)*/ memory::fill(isFrozen, sizeof isFrozen); memory::fill(tisFrozen, sizeof tisFrozen); if(getenv("ARES_CELLS_LOG")) fprintf(stderr, "cells: locked at %u\n", boundaries); } }
+  auto release() -> void { if(getenv("ARES_CELLS_LOG")) fprintf(stderr, "cells: release (boundaries %u)\n", boundaries); locked = false; armed = true; lockedAt = 0xffff; memory::fill(isFrozen, sizeof isFrozen); memory::fill(tisFrozen, sizeof tisFrozen); }
+
+  auto power() -> void {
+    on = false;
+    if(auto e = getenv("ARES_CELLS")) fifoBytes = atoi(e); else return;
+    if(auto e = getenv("ARES_CELLS_LEAD")) lead = atoi(e);
+    auto v = getenv("ARES_CELLS_VRAM"); if(!v) return;
+    if(FILE* f = fopen(v, "rb")) {
+      u8 b[0x10000]; if(fread(b, 1, sizeof b, f) == sizeof b) for(u32 i : range(0x8000)) cvram[i] = b[i * 2] | b[i * 2 + 1] << 8;
+      fclose(f);
+    } else return;
+    memory::copy(startVram, cvram, sizeof cvram);
+    if(getenv("ARES_CELLS_LOG")) fprintf(stderr, "cells: on, FIFO %u bytes\n", fifoBytes);
+    start(); live_ = false; armedGate = false; on = true;
+  }
+  //the SH2 wrote register 0xca = the boundaries it has passed (low 8 bits): the model's cursor on to `lead` past them,
+  //as the FPGA, running the CPU, would be ahead
+  u32 sh2At = 0;
+  template<typename Ram> auto frame(u32 k8, Ram ram) -> void {
+    sh2At += (u8)(k8 - sh2At);
+    if(getenv("ARES_CELLS_LOG") && getenv("ARES_CELLS_LOG")[0] == '2') fprintf(stderr, "cells: sh2 at %u\n", sh2At);
+    u64 total = liveRing ? liveTotal : fifoBytes / 4;
+    while(cursor < total && boundaries < sh2At + lead) {
+      u32 e = entry(cursor++, ram); u32 t = e >> 28, d = e & 0xffff;
+      if(t == 2) fifoAddr = d;
+      else if(t == 1) { vram(fifoAddr, d); fifoAddr = (fifoAddr + 1) & 0xffff; }
+      else if(t == 5) boundary();
+    }
+  }
+  template<typename Ram> auto entry(u32 i, const Ram& ram) -> u32 {   //(the file is little-endian, as the PC wrote it)
+    u32 l = 0x200000 + (liveRing ? i % (0x1f0000 / 4) : i) * 4;   //(ram: a functor from the cart's local address to its word, through the banks)
+    u16 a = ram(l), b = ram(l + 2);   //big-endian words of the file's bytes
+    u32 bytes = (u32)a << 16 | b;     //bytes 0..3 of the entry
+    return (bytes >> 24 & 0xff) | (bytes >> 8 & 0xff00) | (bytes << 8 & 0xff0000) | (bytes << 24);
+  }
+  auto readStore(u32 local) -> n16 {   //a 16-bit read of the stores' window
+    if(local >= TilesAt) { u32 t = (local - TilesAt) >> 2; u32 v = tisFrozen[t] ? tfrozen[t] : tinfo(t); return local & 2 ? (n16)v : (n16)(v >> 16); }
+    u32 off = local < FrozenAt ? local - LiveAt : local - FrozenAt;
+    const u8* s = local < FrozenAt ? &live[0][0] : &frozen[0][0];
+    if(off + 1 >= 512 * Cell) return 0;
+    return s[off] << 8 | s[off + 1];
+  }
+  auto liveFifo(u64 total) -> void { liveRing = true; liveTotal = total; }
+  auto bits() -> n16 { n16 v = 0; for(u32 i : range(16)) if(isFrozen[(group * 16 + i) & 511]) v.bit(i) = 1; return v; }
+};
diff --git a/ares/md/cartridge/board/sapphire-huchost.hpp b/ares/md/cartridge/board/sapphire-huchost.hpp
new file mode 100644
index 0000000..ffe958b
--- /dev/null
+++ b/ares/md/cartridge/board/sapphire-huchost.hpp
@@ -0,0 +1,127 @@
+//Sapphire CD32X's CPU in the cart, a stand-in (github.com/MicroNut99/Sapphire_CD32X docs/40). The real cart runs the
+//game on its FPGA's HuC6280 and writes the FIFO of the video chips' writes (docs/20-24); ares has no model of that
+//FPGA, so with ARES_HUCHOST=<huchost.so> (tools/m3_huchost.sh: the 32X runtime's own C as a library) the board runs
+//the game itself from ARES_HUC_STATE=<DXS1 state>, its data track's sectors from ARES_HUC_TRACK=<image>, and writes
+//the FIFO into a ring at cart 0x200000-0x3EFFFF (window 1, page 1), a picture at a time, up to ARES_HUC_LEAD (4)
+//pictures past the count the SH2 writes to register 0xca. The cell store model (sapphire-cells.hpp) reads the same
+//ring. The pad: the SH2 writes registers 0xcd (low byte) and 0xce (high byte) of the libretro mask, as it would the
+//FPGA's pad register. Not the hardware: the FPGA is checked in its own simulations (fpga/huc).
+#include <dlfcn.h>
+extern "C" { extern u64 aresPcmRawSamples; }   //DIAG (docs/54: mcd/pcm.cpp)
+struct SapphireHuc {
+  static constexpr u32 Ring = 0x1f0000 / 4;   //(entries)
+  bool on = false;
+  u64 produced = 0;            //entries written
+  u32 pictures = 0;            //pictures written
+  u32 lead = 4;
+  u16 pad = 0, padLow = 0;
+  int (*frameFn)(u16, const u32**) = nullptr;
+  int (*audioFn)(const s16**) = nullptr;
+  u32 (*pcFn)() = nullptr; bool pcAbove = false; u32 pcLow = 0, pcAt = 0;   //(docs/60: the CPU's PC at each frame's end, for the board's trap)
+  void (*pokeFn)(u32, u8) = nullptr; u32 pokeAt = 0;   //(docs/58)
+  void (*warpFn)(int) = nullptr; u8 warpLives = 0;      //(docs/58: the stage select)
+  int (*psgFn)(const u16**) = nullptr;   //(docs/54: the frame's PSG register writes)
+  u32 psgCount = 0;
+  u16 psgW[65536]; u16 psgN[1024]; u32 psgWw = 0, psgWr = 0, psgFw = 0, psgFr = 0;   //(docs/55: frames' PSG writes waiting for their vertical blank)
+  bool psgNow = false; u32 psgVc = 0, psgHeld = 0;
+  template<typename Put> auto psgRelease(u32 vcounter, Put put) -> void {
+    if(vcounter >= psgVc) { psgVc = vcounter; return; }   //(not a new frame of the console's)
+    psgVc = vcounter;
+    u32 waiting = psgFw - psgFr;
+    int n = waiting > 24 ? 2 : 1;                           //(far behind: two a blank, to come back)
+    if(waiting > psgHeld) psgHeld = waiting;
+    while(n-- && psgFr != psgFw) {
+      for(u32 k = psgN[psgFr & 1023]; k; k--) { put(0x07f100 + (psgCount & 1023) * 2, psgW[psgWr++ & 65535]); psgCount++; }
+      psgFr++;
+      if(auto w = getenv("ARES_PCM_RAW")) { static FILE* f; if(!f) { string nn = {w, ".at"}; f = fopen(nn, "wb"); } if(f) { u32 k = (u32)aresPcmRawSamples; fwrite(&k, 4, 1, f); } }   //DIAG
+      put(0x07f000, 0x5450); put(0x07f002, (u16)psgCount);
+    }
+  }
+  //(Sapphire docs/55, ARES_HUC_PACE=1) the game at its own rate: a frame made a vertical blank at most, up to what the SH2 allows
+  //(want) - not all of them at once when the SH2 asks, which no cart would do and which chops the sound
+  bool pace = false; u32 want = 0, credit = 0, lastVc = 0, burst = 0;   //(burst: frames that had to be made at once for the SH2)
+  const u16* (*vramFn)() = nullptr;   //(DIAG: ARES_HUC_VCHECK)
+  u16 vramAt[64][0x8000]; u32 vramPic[64];   //(the game's VRAM at the last 64 pictures, by picture)
+  u32 samples = 0;            //(docs/44: PWM samples written to the ring at cart 0x3F0000, 32,768 of them; register 0xcc)
+  static constexpr u32 PwmCycle = 1044;
+
+  auto power() -> void {
+    if(getenv("ARES_HUC_LOG")) fprintf(stderr, "huchost: power (had %u pictures)\n", pictures);
+    on = false; produced = 0; pictures = 0; pad = 0; samples = 0;
+    auto so = getenv("ARES_HUCHOST"); if(!so) return;
+    void* h = dlopen(so, RTLD_NOW | RTLD_LOCAL);
+    if(!h) { fprintf(stderr, "huchost: %s\n", dlerror()); return; }
+    auto init = (int (*)(const char*, const char*))dlsym(h, "huchost_init");
+    frameFn = (int (*)(u16, const u32**))dlsym(h, "huchost_frame");
+    pcFn = (u32 (*)())dlsym(h, "huchost_pc"); pcAbove = false; pcLow = 0;
+    audioFn = (int (*)(const s16**))dlsym(h, "huchost_audio");
+    psgFn = (int (*)(const u16**))dlsym(h, "huchost_psg"); psgCount = 0;
+    pokeFn = (void (*)(u32, u8))dlsym(h, "huchost_poke");
+    warpFn = (void (*)(int))dlsym(h, "huchost_warp");
+    if(!getenv("ARES_HUC_PSGRING")) psgFn = nullptr;
+    psgNow = getenv("ARES_HUC_PSGRING") && getenv("ARES_HUC_PSGRING")[0] == '2'; psgWw = psgWr = psgFw = psgFr = 0; psgVc = 0;
+    vramFn = (const u16* (*)())dlsym(h, "huchost_vram");
+    if(!init || !frameFn || !init(getenv("ARES_HUC_STATE"), getenv("ARES_HUC_TRACK"))) { fprintf(stderr, "huchost: not started\n"); return; }
+    if(auto e = getenv("ARES_HUC_LEAD")) lead = atoi(e);
+    pace = getenv("ARES_HUC_PACE") != nullptr; want = 0; credit = 0;
+    on = true;
+    fprintf(stderr, "huchost: on\n");
+  }
+  //pictures up to `want`: the game run a frame at a time, its entries into the ring (put(local, word))
+  template<typename Put> auto produce(u32 want, Put put) -> void {
+    while(on && pictures < want) {
+      const u32* e = nullptr; int n = frameFn(pad, &e);
+      if(pcFn) { u32 pc = pcFn() & 0xffff; if(pc >= 0x2000) pcAbove = true; else if(pcAbove) { pcLow++; pcAt = pc; } }   //(docs/60: below $2000 after having run above it)
+      if(auto w = getenv("ARES_PCM_RAW"); w && (!psgFn || psgNow)) {   //DIAG (docs/54): the PCM capture's sample count at each game frame made (<file>.at, u32) - or, with the writes let in a frame a blank, at each frame let in (psgRelease)
+        static FILE* f; if(!f) { string nn = {w, ".at"}; f = fopen(nn, "wb"); }
+        if(f) { u32 k = (u32)aresPcmRawSamples; fwrite(&k, 4, 1, f); }
+      }
+      if(psgFn) {   //(Sapphire docs/54, the BootCamp's TPSG) the PSG's register writes for the ring the 68000 reads for the Sub-CPU:
+        //cart 0x07F000 (window 0) = 0x5450, + 2 the count of writes so far, from + 0x100 1,024 words (register << 8 | value).
+        //(docs/55) The cart's game runs at its own rate, so its writes reach the ring a frame's at a time, a frame apart. This
+        //stand-in makes frames when the SH2 asks, several at once: each frame's writes are kept here and let into the ring one
+        //frame a vertical blank (psgRelease, from the board's reads) - ARES_HUC_PSGRING=2: at once, as made
+        const u16* w = nullptr; int nw = psgFn(&w);
+        if(psgNow) { for(int i = 0; i < nw; i++) { put(0x07f100 + (psgCount & 1023) * 2, w[i]); psgCount++; } put(0x07f000, 0x5450); put(0x07f002, (u16)psgCount); }
+        else if(psgFw - psgFr < 1000) { for(int i = 0; i < nw; i++) psgW[psgWw++ & 65535] = w[i]; psgN[psgFw++ & 1023] = (u16)nw; }
+      }
+      if(audioFn) {   //(docs/44) the frame's sound as the PWM's pulse widths, 1..cycle-1 about the middle
+        const s16* a = nullptr; int na = audioFn(&a);
+        if(auto w = getenv("ARES_HUC_WAV")) {   //DIAG (docs/48): the stand-in's sound in the game's time - raw s16, 22,044 Hz, and its count a frame (<w>.n, u16)
+          static FILE *f, *fn; if(!f) { f = fopen(w, "wb"); string nn = {w, ".n"}; fn = fopen(nn, "wb"); }
+          if(f) { fwrite(a, 2, na, f); u16 k = na; fwrite(&k, 2, 1, fn); }
+        }
+        for(int i = 0; i < na; i++) {
+          s32 w = PwmCycle / 2 + (s32)a[i] * (s32)(PwmCycle / 2 - 2) / 32768;
+          put(0x3f0000 + (samples & 0x7fff) * 2, (u16)w);
+          samples++;
+        }
+      }
+      for(int i = 0; i < n; i++) {
+        u32 l = 0x200000 + (u32)(produced % Ring) * 4, x = e[i];
+        put(l, (u16)((x & 0xff) << 8 | (x >> 8 & 0xff)));          //(little-endian, as the files the PC wrote)
+        put(l + 2, (u16)((x >> 16 & 0xff) << 8 | (x >> 24 & 0xff)));
+        produced++;
+        if(pace && (x >> 28) == 5 && (pictures + 1) % 3000 == 0) fprintf(stderr, "huchost: %u game frames made, %u of them at once for the SH2\n", pictures + 1, burst);
+        if(produced % Ring == 0 && getenv("ARES_HUC_LOG")) fprintf(stderr, "huchost: ring wrapped at picture %u\n", pictures);
+        if((x >> 28) == 5) { if(vramFn && getenv("ARES_HUC_VCHECK")) { memory::copy(vramAt[pictures & 63], vramFn(), 0x10000); vramPic[pictures & 63] = pictures; } pictures++; if(getenv("ARES_HUC_LOG") && pictures % 300 == 0) fprintf(stderr, "huchost: %u pictures, %llu entries, pad %04x\n", pictures, (unsigned long long)produced, (unsigned)pad); }
+      }
+    }
+  }
+  auto write(u32 r, u32 v) -> bool {
+    if(!on) return false;
+    //(Sapphire docs/58: the options menu) the poke port into the cart CPU's RAM: 0xcf the address' low byte, 0xd0 its high
+    //byte, 0xd1 the value - written at once (below 0x2000 the base RAM, from 0x2000 the CD RAM, as the recordings' pokes)
+    if(r == 0xcf) { pokeAt = (pokeAt & 0xff00) | v; return true; }
+    if(r == 0xd0) { pokeAt = (pokeAt & 0x00ff) | v << 8; return true; }
+    if(r == 0xd1) { if(pokeFn) pokeFn(pokeAt, v); if(getenv("ARES_HUC_LOG")) fprintf(stderr, "huchost: poke %04x = %02x\n", pokeAt, v); return true; }
+    //0xd2: a new game held to stage 1-5 (the stand-in resets its machine, presses RUN to the game's start and serves the
+    //stage's own sectors - sapmhost.c huchost_warp; on the cart the engine's reset, feed and poke port)
+    //(0xd3 first: the new game's lives, 0 the game's own)
+    if(r == 0xd3) { warpLives = v; return true; }
+    if(r == 0xd2) { if(warpFn) warpFn(v | warpLives << 8); if(getenv("ARES_HUC_LOG")) fprintf(stderr, "huchost: warp to stage %d, lives %d\n", v, warpLives); return true; }
+    if(r == 0xcd) { padLow = v; if(getenv("ARES_HUC_LOG2")) fprintf(stderr, "huchost: w cd %02x\n", v); return true; }
+    if(r == 0xce) { u16 p = (u16)(v << 8 | padLow); if(p != pad && getenv("ARES_HUC_LOG")) fprintf(stderr, "huchost: pad %04x at picture %u\n", p, pictures); pad = p; return true; }
+    return false;
+  }
+};
