diff --git a/ares/md/cartridge/board/sapx/trackpak.c b/ares/md/cartridge/board/sapx/trackpak.c
new file mode 100644
index 0000000..a432af4
--- /dev/null
+++ b/ares/md/cartridge/board/sapx/trackpak.c
@@ -0,0 +1,70 @@
+/* trackpak.c - Sapphire docs/49: a data-track sector from tools/m3_trackpack.py's file (the track's different sectors
+   once each, LZ4 blocks), the way the cart's copy is read in place of the CD. Plain C with no library: the same code
+   builds for the PC and the SH2. trackpak_read checks what it rebuilt against the sector's FNV-1a in the file.
+
+   cc -O2 -DTRACKPAK_MAIN trackpak.c -o trackpak && ./trackpak <pak> <iso>  : every sector against the track */
+#include <stdint.h>
+#include <string.h>
+#include "trackpak.h"
+
+static uint32_t be32(const uint8_t *p) { return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3]; }
+
+int trackpak_open(TrackPak *k, const uint8_t *file, uint32_t size)
+{
+    if (size < 0x14 || memcmp(file, "SPAK", 4) || be32(file + 4) != 1) return -1;
+    k->f = file; k->n = be32(file + 8); k->nu = be32(file + 12); k->data = be32(file + 16);
+    k->map = file + 0x14; k->offs = k->map + 4 * k->n; k->sums = k->offs + 4 * (k->nu + 1);
+    if (k->data > size || k->data + be32(k->offs + 4 * k->nu) > size) return -1;
+    k->reads = k->bad = 0;
+    return 0;
+}
+
+static int lz4_block(const uint8_t *s, uint32_t n, uint8_t *out, uint32_t cap)
+{
+    uint32_t i = 0, o = 0;
+    while (i < n) {
+        const uint8_t t = s[i++]; uint32_t L = t >> 4;
+        if (L == 15) { uint8_t x; do { if (i >= n) return -1; x = s[i++]; L += x; } while (x == 255); }
+        if (i + L > n || o + L > cap) return -1;
+        memcpy(out + o, s + i, L); i += L; o += L;
+        if (i >= n) break;
+        if (i + 2 > n) return -1;
+        const uint32_t off = s[i] | (uint32_t)s[i + 1] << 8; i += 2;
+        uint32_t m = (t & 15) + 4;
+        if ((t & 15) == 15) { uint8_t x; do { if (i >= n) return -1; x = s[i++]; m += x; } while (x == 255); }
+        if (off == 0 || off > o || o + m > cap) return -1;
+        for (uint32_t j = 0; j < m; j++, o++) out[o] = out[o - off];   /* (overlapping: byte by byte) */
+    }
+    return (int)o;
+}
+
+int trackpak_read(TrackPak *k, uint32_t sector, uint8_t out[2048])
+{
+    k->reads++;
+    if (sector >= k->n) { k->bad++; return -1; }
+    const uint32_t e = be32(k->map + 4 * sector), u = e & 0xFFFFFF;
+    const uint32_t a = be32(k->offs + 4 * u), b = be32(k->offs + 4 * u + 4);
+    const uint8_t *p = k->f + k->data + a;
+    if (e & 0x80000000u) { if (b - a != 2048) { k->bad++; return -1; } memcpy(out, p, 2048); }
+    else if (lz4_block(p, b - a, out, 2048) != 2048) { k->bad++; return -1; }
+    uint32_t h = 0x811C9DC5u;
+    for (int i = 0; i < 2048; i++) h = (h ^ out[i]) * 0x01000193u;
+    if (h != be32(k->sums + 4 * sector)) { k->bad++; return -1; }
+    return 0;
+}
+
+#ifdef TRACKPAK_MAIN
+#include <stdio.h>
+#include <stdlib.h>
+static uint8_t *slurp(const char *p, long *n) { FILE *f = fopen(p, "rb"); if (!f) return 0; fseek(f, 0, SEEK_END); *n = ftell(f);
+    fseek(f, 0, SEEK_SET); uint8_t *m = malloc(*n); if (fread(m, 1, *n, f) != (size_t)*n) return 0; fclose(f); return m; }
+int main(int argc, char **argv)
+{
+    long np, ni; uint8_t *p = slurp(argv[1], &np), *iso = slurp(argv[2], &ni); TrackPak k; uint8_t s[2048];
+    if (!p || !iso || trackpak_open(&k, p, (uint32_t)np)) { printf("trackpak: can't open\n"); return 2; }
+    long diff = 0;
+    for (uint32_t i = 0; i < k.n; i++) if (trackpak_read(&k, i, s) || memcmp(s, iso + (long)i * 2048, 2048)) diff++;
+    printf("trackpak: %u sectors (%u different) from %.2f MB: %ld differ from the track, %u failed checks\n", k.n, k.nu, np / 1048576.0, diff, k.bad);
+    return diff != 0;
+}
+#endif
diff --git a/ares/md/cartridge/board/sapx/trackpak.h b/ares/md/cartridge/board/sapx/trackpak.h
new file mode 100644
index 0000000..19e746e
--- /dev/null
+++ b/ares/md/cartridge/board/sapx/trackpak.h
@@ -0,0 +1,8 @@
+/* trackpak.h - Sapphire docs/49: the data track's sectors from the cart's packed copy (tools/m3_trackpack.py) */
+#ifndef TRACKPAK_H
+#define TRACKPAK_H
+#include <stdint.h>
+typedef struct { const uint8_t *f, *map, *offs, *sums; uint32_t n, nu, data, reads, bad; } TrackPak;
+int trackpak_open(TrackPak *k, const uint8_t *file, uint32_t size);      /* 0, or -1: not a pack */
+int trackpak_read(TrackPak *k, uint32_t sector, uint8_t out[2048]);       /* 0, or -1: out of range or a bad check */
+#endif
diff --git a/ares/md/cartridge/board/sapx/vdc_model.c b/ares/md/cartridge/board/sapx/vdc_model.c
new file mode 100644
index 0000000..bce1cee
--- /dev/null
+++ b/ares/md/cartridge/board/sapx/vdc_model.c
@@ -0,0 +1,172 @@
+/* vdc_model.c - M2e: the PC Engine's video chips as the game sees them (HuC6270 VDC, HuC6260 VCE), our own
+ * model, written from Mednafen's behaviour (docs/11) and checked against its trace. No pixels: the CD32X draws
+ * from this state (M1). What it keeps: VRAM, the sprite table (SAT), the colour table, the registers.
+ *
+ * Timing (when the sprite table is copied, when a VRAM DMA runs, when the status bits rise): untimed, it is given from
+ * outside (vdc_event(): the trace check passes Mednafen's events); timed, vdc_timing.c makes it (docs/13). */
+#include <stdint.h>
+#include <string.h>
+#include "vdc_model.h"
+
+static const uint16_t vram_inc[4] = { 1, 32, 64, 128 };
+void (*vdc_line0_hook)(Vdc *v);                              /* (Sapphire docs/55: at the display's first line) */
+void (*vdc_split_hook)(Vdc *v, int what);                    /* (docs/55: 1 a raster match, -1 the display's end, 0 a CR write) */
+void (*vdc_scroll_hook)(Vdc *v);                             /* (docs/105: each BXR / BYR write) */
+int vdc_scroll_reg;                                          /* (Sapphire docs/59: which of them the hook's write was - 7 or 8) */
+void (*vdc_vram_hook)(unsigned addr);                       /* (docs/101: each VRAM word written, for the video window's stamps) */
+
+void vdc_init(Vdc *v) { memset(v, 0, sizeof *v); v->irq_rise = v->irq_prev_rise = INT64_MAX; v->irq_prev_clear = 0; }
+
+int vdc_watch = -1;                           /* debugging: report writes to one VRAM word */
+#include <stdio.h>
+static void commit_pending(Vdc *v)
+{
+    /* the VDC holds an access while it is busy: with the timing model, its sprite-table copy, a VRAM DMA, or the
+       16-clock phase in each horizontal sync (docs/13); without it, as the trace's events say */
+    if (v->timed ? (v->sat_dma > 0 || v->dma_running || v->myst_ph) : v->busy) return;
+    if (v->pending_write) {
+        if (v->pending_write_addr == vdc_watch) fprintf(stderr, "  VRAM %04X <- %04X\n", vdc_watch, v->pending_write_latch);
+        if (v->pending_write_addr < 0x8000) { v->vram[v->pending_write_addr] = v->pending_write_latch; if (vdc_vram_hook) vdc_vram_hook(v->pending_write_addr); }   /* 32 K words */
+        v->pending_write = 0;
+    }
+    if (v->pending_read) { v->read_buffer = v->vram[v->pending_read_addr]; v->pending_read = 0; }
+}
+
+void vdc_commit(Vdc *v) { commit_pending(v); }
+
+/* the CPU touches the data port while a DMA runs: it waits for the DMA to finish (Mednafen DoWaitStates) */
+static void wait_states(Vdc *v)
+{
+    if (v->timed) return;                     /* timed: the caller has waited (trace_main.c) */
+    if (v->dma_running) vdc_dma_finish(v);
+    v->busy = 0;
+    commit_pending(v);
+}
+
+void vdc_dma_finish(Vdc *v)
+{
+    if (!v->dma_running) return;
+    do {
+        const uint16_t w = v->vram[v->SOUR];
+        if (v->DESR == vdc_watch) fprintf(stderr, "  VRAM %04X <- %04X (DMA from %04X)\n", vdc_watch, w, v->SOUR);
+        v->vram[v->DESR] = w; if (vdc_vram_hook) vdc_vram_hook(v->DESR);
+        v->SOUR += (v->DCR & 4) ? -1 : 1;
+        v->DESR += (v->DCR & 8) ? -1 : 1;
+        v->LENR--;
+    } while (v->LENR != 0xFFFF);
+    v->dma_running = 0;
+}
+
+void vdc_event(Vdc *v, int kind, uint32_t arg)
+{
+    switch (kind) {
+    case 3:                                   /* the sprite table copied from VRAM at DVSSR (1024 VDC clocks busy) */
+        memcpy(v->sat, &v->vram[v->DVSSR], 256 * 2);
+        v->satb_pending = 0;
+        v->busy = 1;
+        break;
+    case 4:                                   /* a VRAM-to-VRAM DMA starts: it reads and writes as it goes; the CPU
+                                                 can't see VRAM until it ends, so it is done here at once */
+        v->dma_pending = 0; v->dma_running = 1;
+        vdc_dma_finish(v);
+        v->dma_running = 1;                   /* (the end event clears it) */
+        break;
+    case 5: v->dma_running = 0; v->busy = 0; commit_pending(v); break;
+    case 6: v->status |= (uint8_t)arg; break; /* an interrupt source: VD, RR, DS, DV */
+    case 7: v->busy = 0; commit_pending(v); break;   /* the sprite table copy's 1024 clocks are over */
+    }
+}
+
+uint8_t vdc_read(Vdc *v, unsigned a)
+{
+    const int msb = a & 1;
+    switch (a & 3) {
+    case 0: {
+        const uint8_t r = (uint8_t)(v->status | ((v->timed && (v->pending_read || v->pending_write)) ? 0x40 : 0));
+        if (v->timed && (v->status & 0x3F)) { v->irq_prev_rise = v->irq_rise; v->irq_prev_clear = v->now; }
+        if (v->timed) v->irq_rise = INT64_MAX;
+        v->status &= ~0x3F;                   /* untimed: bit 6 (busy) depends on timing, the checker masks it */
+        return r;
+    }
+    case 2: case 3: {
+        wait_states(v);
+        const uint8_t r = msb ? (uint8_t)(v->read_buffer >> 8) : (uint8_t)v->read_buffer;
+        if (v->select == 2 && msb) {
+            v->pending_read = 1; v->pending_read_addr = v->MARR;
+            v->MARR += vram_inc[(v->CR >> 11) & 3];
+            commit_pending(v);
+        }
+        return r;
+    }
+    }
+    return 0;
+}
+
+#define SETP(reg, val, msb) (reg) = (uint16_t)((msb) ? (((reg) & 0x00FF) | ((val) << 8)) : (((reg) & 0xFF00) | (val)))
+
+void vdc_write(Vdc *v, unsigned a, uint8_t val)
+{
+    const int msb = a & 1;
+    switch (a & 3) {
+    case 0: v->select = val & 0x1F; return;
+    case 1: return;
+    }
+    switch (v->select) {
+    case 0x00: SETP(v->MAWR, val, msb); break;
+    case 0x01: SETP(v->MARR, val, msb);
+        if (msb) {
+            wait_states(v);
+            v->pending_read = 1; v->pending_read_addr = v->MARR;
+            v->MARR += vram_inc[(v->CR >> 11) & 3];
+            commit_pending(v);
+        }
+        break;
+    case 0x02:
+        if (!msb) v->write_latch = val;
+        else {
+            wait_states(v);
+            v->pending_write = 1; v->pending_write_addr = v->MAWR;
+            v->pending_write_latch = (uint16_t)(v->write_latch | val << 8);
+            v->MAWR += vram_inc[(v->CR >> 11) & 3];
+            commit_pending(v);
+        }
+        break;
+    case 0x05: SETP(v->CR, val, msb); if (vdc_split_hook) vdc_split_hook(v, 0); break;
+    case 0x06: SETP(v->RCR, val, msb); v->RCR &= 0x3FF; break;
+    case 0x07: SETP(v->BXR, val, msb); v->BXR &= 0x3FF; if (vdc_scroll_hook) { vdc_scroll_reg = 7; vdc_scroll_hook(v); } break;
+    case 0x08: SETP(v->BYR, val, msb); v->BYR &= 0x1FF; v->bg_ymoo = v->BYR; if (vdc_scroll_hook) { vdc_scroll_reg = 8; vdc_scroll_hook(v); } break;
+    case 0x09: SETP(v->MWR, val, msb); break;
+    case 0x0A: SETP(v->HSR, val, msb); break;
+    case 0x0B: SETP(v->HDR, val, msb); break;
+    case 0x0C: SETP(v->VSR, val, msb); break;
+    case 0x0D: SETP(v->VDR, val, msb); break;
+    case 0x0E: SETP(v->VCR, val, msb); break;
+    case 0x0F: SETP(v->DCR, val, msb); break;
+    case 0x10: SETP(v->SOUR, val, msb); break;
+    case 0x11: SETP(v->DESR, val, msb); break;
+    case 0x12: SETP(v->LENR, val, msb); if (msb) v->dma_pending = 1; break;
+    case 0x13: SETP(v->DVSSR, val, msb); v->satb_pending = 1; break;
+    }
+}
+
+uint8_t vce_read(Vdc *v, unsigned a)
+{
+    switch (a & 7) {
+    case 4: return (uint8_t)v->color[v->ctaddress & 0x1FF];
+    case 5: { uint8_t r = (uint8_t)(((v->color[v->ctaddress & 0x1FF] >> 8) & 1) | 0xFE);
+              v->ctaddress = (v->ctaddress + 1) & 0x1FF; return r; }
+    }
+    return 0xFF;
+}
+
+void vce_write(Vdc *v, unsigned a, uint8_t val)
+{
+    switch (a & 7) {
+    case 0: if (v->timed) vt_dot_clock(v, val); v->vce_cr = val; break;
+    case 2: v->ctaddress = (uint16_t)((v->ctaddress & 0x100) | val); break;
+    case 3: v->ctaddress = (uint16_t)((v->ctaddress & 0x0FF) | (val & 1) << 8); break;
+    case 4: v->color[v->ctaddress & 0x1FF] = (uint16_t)((v->color[v->ctaddress & 0x1FF] & 0x100) | val); break;
+    case 5: v->color[v->ctaddress & 0x1FF] = (uint16_t)((v->color[v->ctaddress & 0x1FF] & 0xFF) | (val & 1) << 8);
+            v->ctaddress = (v->ctaddress + 1) & 0x1FF; break;
+    }
+}
diff --git a/ares/md/cartridge/board/sapx/vdc_model.h b/ares/md/cartridge/board/sapx/vdc_model.h
new file mode 100644
index 0000000..80730ff
--- /dev/null
+++ b/ares/md/cartridge/board/sapx/vdc_model.h
@@ -0,0 +1,55 @@
+/* vdc_model.h - M2e: the VDC / VCE state (vdc_model.c), and M2 timing: when the chips do things (vdc_timing.c) */
+#pragma once
+#include <stdint.h>
+typedef struct Vdc {
+    uint16_t vram[65536], sat[256], color[512];
+    uint8_t select, write_latch, status, vce_cr;
+    uint16_t MAWR, MARR, CR, RCR, BXR, BYR, MWR, HSR, HDR, VSR, VDR, VCR, DCR, SOUR, DESR, LENR, DVSSR;
+    uint16_t read_buffer, ctaddress;
+    uint8_t pending_read, pending_write, dma_pending, dma_running, satb_pending, busy;
+    uint16_t pending_read_addr, pending_write_addr, pending_write_latch;
+
+    /* --- timing (vdc_timing.c, docs/13): used when timed is set; times are master clocks (21.48 MHz) --- */
+    int timed;
+    int64_t now;                                    /* the time the chips have run to */
+    int64_t tick_now;                               /* the VDC clock being processed */
+    /* the VCE: the line (hblank 237 + 1128) and the frame (vblank 4095 + the rest), the VDC's clock divider */
+    int hblank, vblank, lc263, dot_clock;
+    int32_t hblank_ctr, vblank_ctr, clkdiv, ratio, scanline, need_sl_reset;
+    int exit_req; int64_t exit_time;               /* Mednafen ends a run slice: 1 at line 123, 2 at the frame's end */
+    /* the VDC: horizontal and vertical phases and their register caches, the busy counters */
+    int hphase, vphase;
+    int32_t hphase_ctr, vphase_ctr, myst_ctr, sat_dma, spr_fetch;
+    int myst_ph, need_rcr_inc, need_vb_test, need_sat_test, burst_mode, in_exhsync, in_exvsync;
+    uint32_t rcr_count, hsw_c, hds_c, hdw_c, hde_c, vds_c, vsw_c, vdw_c, vcr_c;
+    uint16_t cr_c, mwr_c, dma_buf;
+    int32_t vdma_cyc; int dma_rw;
+    /* the IRQ line (status & 0x3F): when it last rose, and the interval before the last status read cleared it */
+    int64_t irq_rise, irq_prev_rise, irq_prev_clear;
+    long dma_cut;                                   /* VRAM DMAs cut short by the display starting (none expected) */
+    /* docs/105: the background's offsets each line draws with (Mednafen's BG_YMoo / BG_YOffset / BG_XOffset): Y set by
+       a BYR write or at the display's first line, one up a line; X taken from BXR at the display start's third step.
+       lines[raster counter]: (X, Y) as the line took them - the picture's line table */
+    uint16_t bg_ymoo, bg_yoff; int need_bgy_inc;
+    uint16_t lines[263][2];
+} Vdc;
+void vdc_init(Vdc *v);
+uint8_t vdc_read(Vdc *v, unsigned a);
+void vdc_write(Vdc *v, unsigned a, uint8_t val);
+uint8_t vce_read(Vdc *v, unsigned a);
+void vce_write(Vdc *v, unsigned a, uint8_t val);
+void vdc_event(Vdc *v, int kind, uint32_t arg);
+void vdc_dma_finish(Vdc *v);
+void vdc_commit(Vdc *v);                            /* commit a held access if the VDC isn't busy */
+
+/* vdc_timing.c */
+void vt_start(Vdc *v, const uint32_t *r, int64_t t0);   /* from the core's dumpvdcstate (96 u32) at time t0 */
+void vt_run(Vdc *v, int64_t t);                     /* run the chips to time t */
+int32_t vt_next_event(Vdc *v, int64_t cd_next);     /* master clocks to the VCE's next event (Mednafen CalcNextEvent) */
+int vt_irq_at(const Vdc *v, int64_t t);             /* was the VDC's IRQ line high at time t */
+void vt_dot_clock(Vdc *v, uint8_t vce_cr);          /* a VCE control write */
+extern void (*vdc_line0_hook)(struct Vdc *v);              /* Sapphire docs/55: the display's first line (NULL: none) */
+extern void (*vdc_split_hook)(struct Vdc *v, int what);    /* docs/55: 1 a raster match, -1 the display's end, 0 a CR write */
+extern void (*vdc_scroll_hook)(struct Vdc *v);              /* docs/105: called after each BXR / BYR write (NULL: none) */
+extern int vdc_scroll_reg;                                  /* (Sapphire docs/59: 7 or 8, the register the hook's write was to) */
+extern void (*vdc_vram_hook)(unsigned addr);              /* docs/101: called with each VRAM word written (NULL: none) */
diff --git a/ares/md/cartridge/board/sapx/vdc_timing.c b/ares/md/cartridge/board/sapx/vdc_timing.c
new file mode 100644
index 0000000..44e1cb9
--- /dev/null
+++ b/ares/md/cartridge/board/sapx/vdc_timing.c
@@ -0,0 +1,252 @@
+/* vdc_timing.c - M2: when the PC Engine's video chips do things (docs/13). Our own model of the HuC6260 VCE's line
+ * and frame counters and the HuC6270 VDC's horizontal and vertical phases, written from Mednafen's behaviour (no
+ * Mednafen code) and checked against its trace: the interrupts (vertical blank, raster, sprite-table and VRAM DMA
+ * ends), the sprite-table copy, the VRAM DMA as it runs, and the times the VDC holds a CPU access back.
+ *
+ * Time is master clocks (21.48 MHz). The VCE: a line is 1,365 (horizontal blank 237, then 1,128); a frame is 263
+ * lines (358,995) with the 263-line bit, 357,630 without; vertical blank 4,095 of it. The VDC runs on its own clock,
+ * one tick every 4 master clocks (3 or 2 at the faster dot clocks), on a grid that the line doesn't divide.
+ *
+ * The VDC's line, from the end of the horizontal sync: HSW 8 ticks, then HDS (display start: three steps, (HDS+1)*8
+ * in all), HDW (the display, (HDW+1)*8 - 4), HDW_FINAL (4: the raster counter steps here), HDE ((HDE+1)*8), HSW
+ * ((HSW+1)*8), round again until the VCE's next sync restarts it. 48 ticks after a horizontal sync starts, the VDC
+ * is busy for 16 ticks: an access the CPU makes to the VRAM data port is held until it ends. The frame: VSW, VDS,
+ * VDW (the display lines: sprites fetched for each, up to 16, 4 ticks each), VCR; leaving VDW, the sprite table is
+ * copied (1,024 ticks busy) if asked for, then a pending VRAM DMA runs (4 ticks a word). */
+#include <string.h>
+#include "vdc_model.h"
+
+enum { H_HDS, H_HDS2, H_HDS3, H_HDW, H_HDW_FINAL, H_HDE, H_HSW };
+enum { V_VDS, V_VDW, V_VCR, V_VSW };
+static const int32_t ratios[4] = { 4, 3, 2, 2 };
+
+static void raise(Vdc *v, uint8_t bit)
+{
+    if (!(v->status & 0x3F)) v->irq_rise = v->tick_now;      /* the IRQ line goes high at this tick */
+    v->status |= bit;
+}
+
+static uint32_t t_byr(const Vdc *v) { return 1 + (v->hds_c > 2 ? (v->hds_c + 1) * 8 - 24 + 2 : 0); }
+static uint32_t t_bxr(const Vdc *v) { return v->hds_c > 2 ? 1 : 2; }
+
+static void fetch_sprites(Vdc *v)                            /* the sprites on this display line: 4 ticks each, 16 at most */
+{
+    int n = 0;
+    static const int hgt[4] = { 16, 32, 64, 64 };
+    for (int i = 0; i < 64 && n < 16; i++) {
+        const int y = (int)(v->sat[i * 4] & 0x3FF) - 0x40;
+        const uint16_t fl = v->sat[i * 4 + 3];
+        const int h = hgt[(fl >> 12) & 3];
+        if ((int)v->rcr_count >= y && (int)v->rcr_count < y + h) n += (fl & 0x100) ? 2 : 1;
+    }
+    if (n > 16) n = 16;
+    v->spr_fetch = n * 4;                                     /* (sprite overflow, CR bit 1, is not enabled here) */
+}
+
+static void bgy_step(Vdc *v)                                  /* (docs/105: the Y offset's step, where Mednafen takes it) */
+{
+    if (!v->need_bgy_inc) return;
+    v->need_bgy_inc = 0;
+    v->bg_ymoo = v->rcr_count == 0 ? v->BYR : (uint16_t)(v->bg_ymoo + 1);
+}
+
+static void inc_rcr(Vdc *v)
+{
+    bgy_step(v); v->need_bgy_inc = 1;
+    v->rcr_count++;
+    if (--v->vphase_ctr <= 0) {
+        v->vphase = (v->vphase + 1) % 4;
+        switch (v->vphase) {
+        case V_VDS: v->vphase_ctr = (int32_t)v->vds_c + 2; if (vdc_split_hook) vdc_split_hook(v, -1); break;
+        case V_VDW:
+            v->vphase_ctr = (int32_t)v->vdw_c + 1; v->rcr_count = 0;
+            if (vdc_line0_hook) vdc_line0_hook(v);            /* (Sapphire docs/55: the display's first line - an observer) */
+            v->burst_mode = !(v->CR & 0xC0);
+            v->need_vb_test = 1; v->need_sat_test = 1;
+            if (!v->burst_mode) {                             /* the display starts: a copy or a DMA still running stops */
+                if (v->sat_dma > 0) { v->sat_dma = 0; vdc_commit(v); }
+                if (v->dma_running) { v->dma_running = 0; v->dma_cut++; vdc_commit(v); }
+            }
+            break;
+        case V_VCR: v->vphase_ctr = (int32_t)v->vcr_c; if (vdc_split_hook) vdc_split_hook(v, -1); break;   /* (the display's end) */
+        case V_VSW:
+            if (vdc_split_hook) vdc_split_hook(v, -1);
+            v->vphase_ctr = (int32_t)v->vsw_c + 1; v->mwr_c = v->MWR;
+            v->vds_c = (v->VSR >> 8) & 0xFF; v->vsw_c = v->VSR & 0x1F; v->vdw_c = v->VDR & 0x1FF; v->vcr_c = v->VCR & 0xFF;
+            break;
+        }
+    }
+    if (v->vphase == V_VDW && !v->burst_mode) fetch_sprites(v);
+    if ((int)v->rcr_count == (int)v->RCR - 0x40 && (v->CR & 4)) { raise(v, 0x04); if (vdc_split_hook) vdc_split_hook(v, 1); }   /* (docs/55: a raster match) */
+}
+
+static void hds_start(Vdc *v)
+{
+    if (v->need_rcr_inc) { inc_rcr(v); v->need_rcr_inc = 0; }
+    if (v->spr_fetch > 0) { v->spr_fetch = 0; vdc_commit(v); }
+    v->hsw_c = v->HSR & 0x1F; v->hds_c = (v->HSR >> 8) & 0x7F; v->hdw_c = v->HDR & 0x7F; v->hde_c = (v->HDR >> 8) & 0x7F;
+    v->cr_c = v->CR;
+    v->hphase = H_HDS; v->hphase_ctr = (int32_t)t_byr(v);
+}
+
+static void dma_step(Vdc *v)                                  /* one half of a word: read, then write */
+{
+    if (!v->dma_rw) v->dma_buf = v->vram[v->SOUR];
+    else {
+        if (v->DESR < 0x8000) { v->vram[v->DESR] = v->dma_buf; if (vdc_vram_hook) vdc_vram_hook(v->DESR); }
+        v->SOUR += (v->DCR & 4) ? 0xFFFF : 1; v->DESR += (v->DCR & 8) ? 0xFFFF : 1;
+        if (--v->LENR == 0xFFFF) { v->dma_running = 0; vdc_commit(v); if (v->DCR & 2) raise(v, 0x10); return; }
+    }
+    v->dma_rw ^= 1;
+}
+
+static void vdc_tick(Vdc *v)                                  /* one VDC clock */
+{
+    if (v->myst_ctr > 0 && --v->myst_ctr <= 0) {
+        v->myst_ph = !v->myst_ph;
+        if (v->myst_ph) v->myst_ctr = 16; else vdc_commit(v);
+    }
+    if (v->spr_fetch > 0 && --v->spr_fetch <= 0) vdc_commit(v);
+    if (v->vphase != V_VDW && v->need_sat_test) {
+        v->need_sat_test = 0;
+        if (v->satb_pending || (v->DCR & 0x10)) {
+            v->satb_pending = 0; v->sat_dma = 1024;
+            if (v->DVSSR < 0x8000) {
+                uint32_t len = v->DVSSR > 0x8000 - 0x100 ? 0x8000u - v->DVSSR : 256;
+                memcpy(v->sat, &v->vram[v->DVSSR], len * 2);
+            }
+        } else v->burst_mode = 1;
+    }
+    if (v->dma_pending && v->burst_mode) { v->dma_pending = 0; v->dma_running = 1; v->vdma_cyc = 0; v->dma_rw = 0; }
+    if (v->sat_dma > 0) {
+        if (--v->sat_dma <= 0) { if (v->DCR & 1) raise(v, 0x08); vdc_commit(v); v->burst_mode = 1; }
+    } else if (v->dma_running) {
+        if (++v->vdma_cyc >= 2) { v->vdma_cyc = 0; dma_step(v); }
+    }
+    if (--v->hphase_ctr > 0) return;
+    while (v->hphase_ctr <= 0) {
+        v->hphase = (v->hphase + 1) % 7;
+        switch (v->hphase) {
+        case H_HDS: hds_start(v); break;
+        case H_HDS2: v->hphase_ctr = (int32_t)t_bxr(v); if (!v->in_exhsync) bgy_step(v); v->bg_yoff = v->bg_ymoo; break;
+        case H_HDS3: v->hphase_ctr = (int32_t)((v->hds_c + 1) * 8 - t_byr(v) - t_bxr(v));
+            if (v->rcr_count < 263) { v->lines[v->rcr_count][0] = v->BXR; v->lines[v->rcr_count][1] = v->bg_yoff; }
+            break;
+        case H_HDW:
+            v->need_rcr_inc = 1;
+            if (v->vphase != V_VDW && v->need_vb_test) { if (v->CR & 8) raise(v, 0x20); v->need_vb_test = 0; }
+            vdc_commit(v);
+            v->hphase_ctr = (int32_t)(v->hdw_c + 1) * 8 - 4;
+            break;
+        case H_HDW_FINAL:
+            if (v->need_rcr_inc) { inc_rcr(v); v->need_rcr_inc = 0; }
+            v->hphase_ctr = 4;
+            break;
+        case H_HDE: v->hphase_ctr = (int32_t)(v->hde_c + 1) * 8; break;
+        case H_HSW: v->hphase_ctr = (int32_t)(v->hsw_c + 1) * 8; break;
+        }
+    }
+}
+
+static void hsync(Vdc *v, int hb)
+{
+    if ((v->CR >> 4) & 3) { v->in_exhsync = 0; return; }      /* external sync: not used here */
+    v->in_exhsync = hb;
+    if (hb) { v->myst_ctr = 48; v->myst_ph = 0; }             /* into the horizontal sync */
+    else { v->hphase = H_HSW; v->hphase_ctr = 8; }            /* out of it: the line restarts */
+}
+
+static void vsync(Vdc *v, int vb)
+{
+    if (((v->CR >> 4) & 3) >= 2) { v->in_exvsync = 0; return; }
+    v->in_exvsync = vb;
+    if (vb) {
+        v->need_rcr_inc = 0; v->mwr_c = v->MWR;
+        v->vds_c = (v->VSR >> 8) & 0xFF; v->vsw_c = v->VSR & 0x1F; v->vdw_c = v->VDR & 0x1FF; v->vcr_c = v->VCR & 0xFF;
+        v->vphase = V_VSW; v->vphase_ctr = (int32_t)v->vsw_c + 1;
+    }
+}
+
+void vt_run(Vdc *v, int64_t t)
+{
+    while (v->now < t) {
+        int64_t nxt = t;
+        const int64_t th = v->now + v->hblank_ctr, tv = v->now + v->vblank_ctr, tk = v->now + (v->ratio - v->clkdiv);
+        if (th < nxt) nxt = th;
+        if (tv < nxt) nxt = tv;
+        if (tk < nxt) nxt = tk;
+        const int32_t d = (int32_t)(nxt - v->now);
+        v->clkdiv += d; v->hblank_ctr -= d; v->vblank_ctr -= d; v->now = nxt;
+        if (v->clkdiv >= v->ratio) { v->clkdiv -= v->ratio; v->tick_now = v->now; vdc_tick(v); }
+        if (v->hblank_ctr <= 0) {                             /* the VCE's horizontal blank starts or ends */
+            v->hblank ^= 1;
+            if (!v->hblank) {
+                if (v->need_sl_reset) v->scanline = 0; else v->scanline++;
+                /* Mednafen's two run slices a frame end here: at line 123, and at the frame's end, line 14 + the last
+                   line shown + 1 (the core's libretro default shows lines up to 242: 257) */
+                if (v->scanline == 14 + 243) { v->exit_req = 2; v->exit_time = v->now; }
+                else if (v->scanline == 123) { v->exit_req = 1; v->exit_time = v->now; }
+                v->need_sl_reset = 0;
+            }
+            v->hblank_ctr = v->hblank ? 237 : 1128;
+            v->tick_now = v->now; hsync(v, v->hblank);
+        }
+        if (v->vblank_ctr <= 0) {
+            v->vblank ^= 1;
+            v->vblank_ctr = v->vblank ? 4095 : (v->lc263 ? 358995 : 357630) - 4095;
+            if (!v->vblank) v->need_sl_reset = 1;
+            v->tick_now = v->now; vsync(v, v->vblank);
+        }
+    }
+}
+
+static int32_t vdc_next(const Vdc *v)                         /* VDC clocks to its next event */
+{
+    int32_t n = v->hphase_ctr;
+    if (v->sat_dma > 0 && v->sat_dma < n) n = v->sat_dma;
+    if (v->spr_fetch > 0 && v->spr_fetch < n) n = v->spr_fetch;
+    if (v->dma_running) {
+        const int32_t d = ((int32_t)v->LENR + 1) * 4 - v->dma_rw * 2 - v->vdma_cyc;
+        if (d > 0 && d < n) n = d;
+    }
+    return n;
+}
+
+int32_t vt_next_event(Vdc *v, int64_t cd_next)
+{
+    int64_t n = v->hblank_ctr;
+    if (v->vblank_ctr < n) n = v->vblank_ctr;
+    if (cd_next - v->now < n) n = cd_next - v->now;
+    const int64_t c = (int64_t)vdc_next(v) * v->ratio - v->clkdiv;
+    if (c < n) n = c;
+    return n < 1 ? 1 : (int32_t)n;
+}
+
+int vt_irq_at(const Vdc *v, int64_t t)
+{
+    return v->irq_rise <= t || (v->irq_prev_rise <= t && t < v->irq_prev_clear);
+}
+
+void vt_dot_clock(Vdc *v, uint8_t cr)
+{
+    const int dc = cr & 3;
+    if (dc != v->dot_clock) v->clkdiv = 0;                    /* Mednafen restarts the divider */
+    v->dot_clock = dc; v->ratio = ratios[dc]; v->lc263 = (cr & 4) != 0;
+}
+
+void vt_start(Vdc *v, const uint32_t *r, int64_t t0)
+{
+    v->timed = 1; v->now = t0; v->tick_now = t0;
+    v->satb_pending = (uint8_t)r[30]; v->sat_dma = (int32_t)r[31]; v->burst_mode = (int)r[32]; v->vdma_cyc = (int32_t)r[33];
+    v->dma_buf = (uint16_t)r[26]; v->dma_rw = (int)r[27]; v->dma_running = (uint8_t)r[28]; v->dma_pending = (uint8_t)r[29];
+    v->dot_clock = (int)r[36]; v->lc263 = (int)r[37];
+    v->hblank = (int)r[38]; v->hblank_ctr = (int32_t)r[39]; v->vblank = (int)r[40]; v->vblank_ctr = (int32_t)r[41];
+    v->clkdiv = (int32_t)r[42]; v->scanline = (int32_t)r[46]; v->need_sl_reset = (int32_t)r[47]; v->ratio = (int32_t)r[48];
+    v->hphase = (int)r[50]; v->hphase_ctr = (int32_t)r[51]; v->vphase = (int)r[52]; v->vphase_ctr = (int32_t)r[53];
+    v->myst_ctr = (int32_t)r[54]; v->myst_ph = (int)r[55]; v->spr_fetch = (int32_t)r[56]; v->rcr_count = r[57];
+    v->need_rcr_inc = (int)r[58]; v->need_vb_test = (int)r[59]; v->need_sat_test = (int)r[60];
+    v->hsw_c = r[62]; v->hds_c = r[63]; v->hdw_c = r[64]; v->hde_c = r[65];
+    v->vds_c = r[66]; v->vsw_c = r[67]; v->vdw_c = r[68]; v->vcr_c = r[69];
+    v->cr_c = (uint16_t)r[70]; v->mwr_c = (uint16_t)r[71]; v->in_exhsync = (int)r[72]; v->in_exvsync = (int)r[73];
+    v->irq_rise = (v->status & 0x3F) ? t0 : INT64_MAX; v->irq_prev_rise = INT64_MAX; v->irq_prev_clear = 0;
+}
