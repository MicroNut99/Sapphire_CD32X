index 0000000..d04b37d
--- /dev/null
+++ b/ares/md/cartridge/board/sapphire-cells.hpp
@@ -0,0 +1,121 @@
+//Sapphire CD32X's FPGA cell store (github.com/MicroNut99/Sapphire_CD32X docs/28-29, fpga/huc/cellstore.c), a test
+//model on the EverDrive board for the FIFO playback (ARES_CELLS=<the FIFO's bytes>, ARES_CELLS_VRAM=<vdc_start.bin>,
+//ARES_CELLS_LEAD=<frames, default 1>). The FIFO is the level slot's file (cart 0x200000); the model runs its own
+//cursor on it up to ARES_CELLS_LEAD frame boundaries past the count the SH2 writes (register 0xca), as the FPGA would be.
+//The stores are served at cart 0x170000 (live) and 0x194000 (frozen); the frozen bits through the Arcade Card
+//engine's window: write register 0xc6 = group (16 cells), read register 0xc7 = its bits; write 0xc8 = release;
+//read 0xc9 = the boundary count the lock came at (1: the first boundary in the FIFO), 0xffff: not locked yet; write
+//0xca = the boundaries the SH2 has passed (low 8 bits). None of them answers until the SH2 writes 0xcb = 0xa5 then at
+//once 0xcb = 0x5a (the start: the store goes back to vdc_start), so a plain read across the window does nothing.
+struct SapphireCells {
+  static constexpr u32 Cell = 288, Odd = 128, Mask = 272, LiveAt = 0x170000, FrozenAt = 0x194000, TilesAt = 0x1b8000, End = 0x1ba000;
+  u32 tfrozen[2048]; u8 tisFrozen[2048];   //(docs/31: the tiles' hash << 16 | colour mask, as at the lock, at 0x1b8000)
+  u16 cvram[0x8000], startVram[0x8000];
+  bool armedGate = false, live_ = false;   //(the registers answer only after the unlock: 0xcb = 0xa5, then 0xcb = 0x5a at once)
+  u8 live[512][Cell], frozen[512][Cell];
+  u8 isFrozen[512];
+  bool locked = false, armed = false, on = false;
+  u32 fifoBytes = 0, cursor = 0, lead = 1, group = 0;
+  u32 fifoAddr = 0;          //the model's VRAM address (FIFO type 2)
+  u64 liveTotal = 0; bool liveRing = false;   //(docs/40: the FIFO a ring the stand-in CPU writes - its entries so far)
+  u64 freezes = 0;
+
+  auto row(u32 c, u32 y) -> void {
+    u16* w = cvram + c * 64;
+    u32 p0 = w[y], p1 = w[16 + y], p2 = w[32 + y], p3 = w[48 + y];
+    u8* e = live[c] + 8 * y; u8* o = live[c] + Odd + 9 * y;
+    for(u32 x : range(16)) {
+      u32 b = 15 - x;
+      u32 v = (p0 >> b & 1) | (p1 >> b & 1) << 1 | (p2 >> b & 1) << 2 | (p3 >> b & 1) << 3;
+      if(x & 1) e[x >> 1] = (e[x >> 1] & 0xf0) | v; else e[x >> 1] = (e[x >> 1] & 0x0f) | v << 4;
+    }
+    o[0] = e[0] >> 4;
+    for(u32 k = 1; k < 8; k++) o[k] = (e[k - 1] & 15) << 4 | e[k] >> 4;
+    o[8] = (e[7] & 15) << 4;
+    u32 m = (u32)live[c][Mask] << 8 | live[c][Mask + 1];
+    if(p0 | p1 | p2 | p3) m |= 0x8000 >> y; else m &= ~(0x8000u >> y);
+    live[c][Mask] = m >> 8; live[c][Mask + 1] = m;
+  }
+  auto tinfo(u32 t) -> u32 {   //Sapphire's tools/m3rt/rt_bg2.c tile_hash, tile_mask (fpga/huc/cellstore.c tinfo)
+    u16* w = cvram + t * 16; u32 h = 0x811c9dc5;
+    for(u32 k : range(16)) h = (h ^ w[k]) * 0x01000193;
+    u32 m = 0;
+    for(u32 y : range(8)) { u32 p01 = w[y], p23 = w[8 + y];
+      for(u32 x : range(8)) { u32 sh = 7 - x; m |= 1u << ((p01 >> sh & 1) | (p01 >> (sh + 8) & 1) << 1 | (p23 >> sh & 1) << 2 | (p23 >> (sh + 8) & 1) << 3); } }
+    return (u32)(u16)(h ^ h >> 16) << 16 | (m & ~1u);
+  }
+  auto vram(u32 a, u16 w) -> void {
+    if(a >= 0x8000) return;
+    if(cvram[a] == w) return;
+    u32 c = a >> 6;
+    if(locked && !isFrozen[c]) { memory::copy(frozen[c], live[c], Cell); isFrozen[c] = 1; freezes++; }
+    if(locked && !tisFrozen[a >> 4]) { tfrozen[a >> 4] = tinfo(a >> 4); tisFrozen[a >> 4] = 1; }
+    cvram[a] = w; row(c, a & 15);
+  }
+  u32 boundaries = 0, lockedAt = 0xffff;
+  auto start() -> void {
+    memory::copy(cvram, startVram, sizeof cvram);
+    memory::fill(live, sizeof live);
+    for(u32 c : range(512)) for(u32 y : range(16)) row(c, y);
+    memory::fill(isFrozen, sizeof isFrozen); memory::fill(tisFrozen, sizeof tisFrozen); locked = armed = false; cursor = 0; fifoAddr = 0; freezes = 0; sh2At = 0; boundaries = 0; lockedAt = 0xffff;
+  }
+  //a register write (r, v); false: not the store's (the engine's own, or the store still locked out)
+  template<typename Ram> auto write(u32 r, u32 v, Ram ram) -> bool {
+    bool prev = armedGate; armedGate = false;
+    if(r == 0xcb) { if(v == 0xa5) armedGate = true; else if(v == 0x5a && prev) { start(); live_ = true; if(getenv("ARES_CELLS_LOG")) fprintf(stderr, "cells: unlocked\n"); } return true; }
+    if(!live_) return false;
+    if(r == 0xc6) { group = v; return true; }
+    if(r == 0xc8) { release(); return true; }
+    if(r == 0xca) { frame(v, ram); return true; }
+    return false;
+  }
+  const u16 (*checkAt)[0x8000] = nullptr; const u32* checkPic = nullptr;   //(DIAG: ARES_HUC_VCHECK, the stand-in's VRAM by picture)
+  auto boundary() -> void {
+    if(checkAt) { u32 k = boundaries & 63; if(checkPic[k] == boundaries) { u32 bad = 0, first = 0xffff; for(u32 i : range(0x8000)) if(cvram[i] != checkAt[k][i]) { if(!bad) first = i; bad++; }
+      if(bad) { fprintf(stderr, "cells: boundary %u: %u VRAM words apart, first %04x:", boundaries, bad, first); u32 n = 0; for(u32 i : range(0x8000)) if(cvram[i] != checkAt[k][i] && n++ < 6) fprintf(stderr, " %04x=%04x/%04x", i, cvram[i], checkAt[k][i]); fprintf(stderr, "\n"); checkAt = nullptr; } } }
+    boundaries++; if(armed) { armed = false; locked = true; lockedAt = boundaries & 0x7fff;   /*(15 bits, as the RTL: 0xffff is "not locked yet" - Sapphire docs/59)*/ memory::fill(isFrozen, sizeof isFrozen); memory::fill(tisFrozen, sizeof tisFrozen); if(getenv("ARES_CELLS_LOG")) fprintf(stderr, "cells: locked at %u\n", boundaries); } }
+  auto release() -> void { if(getenv("ARES_CELLS_LOG")) fprintf(stderr, "cells: release (boundaries %u)\n", boundaries); locked = false; armed = true; lockedAt = 0xffff; memory::fill(isFrozen, sizeof isFrozen); memory::fill(tisFrozen, sizeof tisFrozen); }
+
+  auto power() -> void {
+    on = false;
+    if(auto e = getenv("ARES_CELLS")) fifoBytes = atoi(e); else return;
+    if(auto e = getenv("ARES_CELLS_LEAD")) lead = atoi(e);
+    auto v = getenv("ARES_CELLS_VRAM"); if(!v) return;
+    if(FILE* f = fopen(v, "rb")) {
+      u8 b[0x10000]; if(fread(b, 1, sizeof b, f) == sizeof b) for(u32 i : range(0x8000)) cvram[i] = b[i * 2] | b[i * 2 + 1] << 8;
+      fclose(f);
+    } else return;
+    memory::copy(startVram, cvram, sizeof cvram);
+    if(getenv("ARES_CELLS_LOG")) fprintf(stderr, "cells: on, FIFO %u bytes\n", fifoBytes);
+    start(); live_ = false; armedGate = false; on = true;
+  }
+  //the SH2 wrote register 0xca = the boundaries it has passed (low 8 bits): the model's cursor on to `lead` past them,
+  //as the FPGA, running the CPU, would be ahead
+  u32 sh2At = 0;
+  template<typename Ram> auto frame(u32 k8, Ram ram) -> void {
+    sh2At += (u8)(k8 - sh2At);
+    if(getenv("ARES_CELLS_LOG") && getenv("ARES_CELLS_LOG")[0] == '2') fprintf(stderr, "cells: sh2 at %u\n", sh2At);
+    u64 total = liveRing ? liveTotal : fifoBytes / 4;
+    while(cursor < total && boundaries < sh2At + lead) {
+      u32 e = entry(cursor++, ram); u32 t = e >> 28, d = e & 0xffff;
+      if(t == 2) fifoAddr = d;
+      else if(t == 1) { vram(fifoAddr, d); fifoAddr = (fifoAddr + 1) & 0xffff; }
+      else if(t == 5) boundary();
+    }
+  }
+  template<typename Ram> auto entry(u32 i, const Ram& ram) -> u32 {   //(the file is little-endian, as the PC wrote it)
+    u32 l = 0x200000 + (liveRing ? i % (0x1f0000 / 4) : i) * 4;   //(ram: a functor from the cart's local address to its word, through the banks)
+    u16 a = ram(l), b = ram(l + 2);   //big-endian words of the file's bytes
+    u32 bytes = (u32)a << 16 | b;     //bytes 0..3 of the entry
+    return (bytes >> 24 & 0xff) | (bytes >> 8 & 0xff00) | (bytes << 8 & 0xff0000) | (bytes << 24);
+  }
+  auto readStore(u32 local) -> n16 {   //a 16-bit read of the stores' window
+    if(local >= TilesAt) { u32 t = (local - TilesAt) >> 2; u32 v = tisFrozen[t] ? tfrozen[t] : tinfo(t); return local & 2 ? (n16)v : (n16)(v >> 16); }
+    u32 off = local < FrozenAt ? local - LiveAt : local - FrozenAt;
+    const u8* s = local < FrozenAt ? &live[0][0] : &frozen[0][0];
+    if(off + 1 >= 512 * Cell) return 0;
+    return s[off] << 8 | s[off + 1];
+  }
+  auto liveFifo(u64 total) -> void { liveRing = true; liveTotal = total; }
+  auto bits() -> n16 { n16 v = 0; for(u32 i : range(16)) if(isFrozen[(group * 16 + i) & 511]) v.bit(i) = 1; return v; }
+};
diff --git a/ares/md/cartridge/board/sapphire-huchost.hpp b/ares/md/cartridge/board/sapphire-huchost.hpp
